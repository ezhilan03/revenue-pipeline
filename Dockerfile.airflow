FROM apache/airflow:slim-3.1.6-python3.12
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
USER root
RUN mkdir -p /opt/revenue && chown airflow:0 /opt/revenue
USER airflow
WORKDIR /opt/revenue
COPY --chown=airflow:0 pyproject.toml uv.lock ./
COPY --chown=airflow:0 src/ src/
RUN uv sync --frozen --no-cache
COPY --chown=airflow:0 dbt/ dbt/
COPY --chown=airflow:0 dags/ /opt/revenue/dags/
ENV AIRFLOW__CORE__DAGS_FOLDER=/opt/revenue/dags
COPY --chown=airflow:0 scripts/check_dag.py /opt/revenue/check_dag.py
WORKDIR /opt/airflow
